# Generated outputs (regenerated by the scripts, not source)
gwrc_tidy.csv
gwrc_trend_results.csv
*.png

# Local environment
.venv_verify/
__pycache__/
.DS_Store

# Ignore the virtual environment inside the krishna-code subfolder & dylan-code subfolder
krishna-code/.venv/
krishna-code/__pycache__/
krishna-code/*.py[cod]
krishna-code/.streamlit/secrets.toml
krishna-code/.streamlit/config.toml
krishna-code/.DS_Store
krishna-code/Thumbs.db

dylan-code/.venv/
dylan-code/__pycache__/
dylan-code/*.py[cod]
dylan-code/.streamlit/secrets.toml
dylan-code/.streamlit/config.toml
dylan-code/.DS_Store
dylan-code/Thumbs.db

# Ignore the data folder as well inside that subfolder, too big to store on github repo (need to manually unzip each time source is downloaded for now)
krishna-code/data
dylan-code/data

# webapp/ (FastAPI + Leaflet + Plotly data explorer): the generated cache, including an
# extracted copy of krishna-code/data.zip's shapefiles, is rebuilt by webapp/build_cache.py
# and is too big for the repo (two files alone are 60MB and 134MB) - never commit it.
webapp/cache/
webapp/.venv/
webapp/__pycache__/
webapp/**/__pycache__/
# The repo-wide *.png rule above would otherwise also strip Leaflet's own vendored marker
# icons, which the map needs to render pins at all.
!webapp/static/vendor/**/*.png